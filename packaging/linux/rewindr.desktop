[Desktop Entry]
Type=Application
Name=Rewindr
Comment=Instant replay: press F8 to save the last 30 seconds
Exec=rewindr
Icon=rewindr
Terminal=false
Categories=AudioVideo;Video;Recorder;
Keywords=replay;clip;record;medal;shadowplay;gaming;
StartupWMClass=rewindr
Actions=save;

[Desktop Action save]
Name=Save the last 30 seconds
Exec=rewindr save
